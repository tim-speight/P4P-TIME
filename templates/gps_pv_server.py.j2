
#!/usr/bin/env python3
import subprocess, time, json, threading
from p4p.server import Server, StaticProvider
from p4p.nt import NTScalar

provider = StaticProvider("GPS")

ntDouble = NTScalar('d')
ntString = NTScalar('s')
ntBool = NTScalar('b')
ntInt = NTScalar('i')

pvs = {
    "CLF-TIMING:GPS:MODE": ntInt.wrap(0),         # 0=unknown, 2=2D, 3=3D
    "CLF-TIMING:GPS:SATVIS": ntInt.wrap(0),
    "CLF-TIMING:GPS:SATUSE": ntInt.wrap(0),
    "CLF-TIMING:GPS:TIME": ntString.wrap(""),
    "CLF-TIMING:GPS:FIX": ntBool.wrap(False),

    "CLF-TIMING:NTP:STRATUM": ntInt.wrap(16),
    "CLF-TIMING:NTP:REFID": ntString.wrap(""),
    "CLF-TIMING:NTP:OFFSET_S": ntDouble.wrap(0.0),
    "CLF-TIMING:NTP:ROOT_DELAY_S": ntDouble.wrap(0.0),
    "CLF-TIMING:NTP:LOCKED": ntBool.wrap(False),
}
for name, val in pvs.items():
    provider.add(name, val)


def read_gpsd():
    try:
        tpv = subprocess.check_output(["gpspipe","-w","-n","10"], timeout=5).decode()
        last_tpv, last_sky = {}, {}
        for line in tpv.splitlines():
            try:
                obj = json.loads(line)
                if obj.get("class") == "TPV":
                    last_tpv = obj
                elif obj.get("class") == "SKY":
                    last_sky = obj
            except Exception:
                pass
        return last_tpv, last_sky
    except Exception:
        return {}, {}


def chrony_tracking():
    out = subprocess.check_output(["/usr/bin/chronyc","-n","tracking"], timeout=5).decode()
    data = {}
    for line in out.splitlines():
        if ":" in line:
            k,v = [x.strip() for x in line.split(":",1)]
            data[k]=v
    return data


def updater():
    while True:
        tpv, sky = read_gpsd()
        mode = int(tpv.get("mode",0) or 0)
        t_iso = tpv.get("time") or ""
        satvis = int(len(sky.get("satellites",[])))
        satuse = int(len([s for s in sky.get("satellites",[]) if s.get("used")]))

        pvs["CLF-TIMING:GPS:MODE"].update(mode)
        pvs["CLF-TIMING:GPS:TIME"].update(t_iso)
        pvs["CLF-TIMING:GPS:SATVIS"].update(satvis)
        pvs["CLF-TIMING:GPS:SATUSE"].update(satuse)
        pvs["CLF-TIMING:GPS:FIX"].update(mode >= 2)

        try:
            tr = chrony_tracking()
            pvs["CLF-TIMING:NTP:REFID"].update(tr.get("Reference ID",""))
            pvs["CLF-TIMING:NTP:STRATUM"].update(int(tr.get("Stratum","16").split()[0]))
            pvs["CLF-TIMING:NTP:OFFSET_S"].update(float(tr.get("Last offset","0").split()[0]))
            pvs["CLF-TIMING:NTP:ROOT_DELAY_S"].update(float(tr.get("Root delay","0").split()[0]))
            locked = tr.get("Leap status","") == "Normal"
            pvs["CLF-TIMING:NTP:LOCKED"].update(locked)
        except Exception:
            pass

        time.sleep(1)

if __name__ == "__main__":
    t = threading.Thread(target=updater, daemon=True)
    t.start()
    Server(providers=[provider], address="{{ pva_listen }}:{{ pva_server_port }}").run()
